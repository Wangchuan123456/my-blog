---
// 3D 樱花花瓣飘落 — 贝塞尔花瓣 + 三维旋转透视
---

<div class="sakura-bg" id="sakura-bg">
  <canvas id="sakura-canvas"></canvas>
</div>

<script>
// @ts-nocheck
(function () {
  if (window.__sakuraLoaded) return;
  window.__sakuraLoaded = true;

  const canvas = document.getElementById('sakura-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let petals = [];
  let animationId = null;
  let isPageVisible = true;
  let resizeTimer = null;
  let mouseX = -9999, mouseY = -9999;
  let lastTime = performance.now();

  // ---------- 配置 ----------
  const CONFIG = {
    petalCount: 35,
    petalSize: { min: 14, max: 30 },
    fallSpeed: { min: 0.3, max: 1.2 },
    swaySpeed: { min: 0.003, max: 0.012 },
    opacity: { min: 0.55, max: 0.95 },
    depthRange: 400,
    focalLength: 500,
    // 鼠标吸引
    attractRadius: 220,
    attractForce: 0.08,
    maxAttractFrames: 120,
    repelForce: 1.2,
  };

  // ---------- 颜色 (#E53543 系) ----------
  const BASE = { r: 229, g: 53, b: 67 };
  function rgba(r, g, b, a) { return `rgba(${r},${g},${b},${a})`; }
  function colorAlpha(alpha) { return rgba(BASE.r, BASE.g, BASE.b, alpha); }
  function colorLight(alpha) { return rgba(Math.min(255, BASE.r+40), Math.min(255, BASE.g+50), Math.min(255, BASE.b+50), alpha); }
  function colorDark(alpha) { return rgba(Math.max(0, BASE.r-40), Math.max(0, BASE.g-15), Math.max(0, BASE.b-15), alpha); }
  function colorVein(alpha) { return rgba(Math.max(0, BASE.r-30), Math.max(0, BASE.g-10), Math.max(0, BASE.b-10), alpha); }

  // ---------- 尺寸 ----------
  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  function debouncedResize() {
    if (resizeTimer) cancelAnimationFrame(resizeTimer);
    resizeTimer = requestAnimationFrame(resize);
  }
  window.addEventListener('resize', debouncedResize);
  resize();

  function rand(a, b) { return Math.random() * (b - a) + a; }
  function randColor() { return colorAlpha(1); }

  // ====== 3D 旋转 ======
  function rotateX(p, a) {
    const c = Math.cos(a), s = Math.sin(a);
    return { x: p.x, y: p.y * c - p.z * s, z: p.y * s + p.z * c };
  }
  function rotateY(p, a) {
    const c = Math.cos(a), s = Math.sin(a);
    return { x: p.x * c + p.z * s, y: p.y, z: -p.x * s + p.z * c };
  }
  function rotateZ(p, a) {
    const c = Math.cos(a), s = Math.sin(a);
    return { x: p.x * c - p.y * s, y: p.x * s + p.y * c, z: p.z };
  }

  // ---------- 3D 投影 ----------
  function project3D(px, py, petal, time) {
    let p = { x: px, y: py, z: 0 };
    p = rotateX(p, petal.rotX + petal.spinX * time);
    p = rotateY(p, petal.rotY + petal.spinY * time);
    p = rotateZ(p, petal.rotZ + petal.spinZ * time);
    p.z += petal.worldZ;
    const scale = CONFIG.focalLength / (CONFIG.focalLength + p.z);
    return { x: p.x * scale, y: p.y * scale, scale, z: p.z };
  }

  // ---------- 绘制花瓣（3D 贝塞尔） ----------
  function drawPetal(petal, time) {
    const s = petal.size;
    const d = petal.d;

    // 贝塞尔控制点（局部坐标）→ 3D 投影
    const p0  = project3D(0,           s * 0.5,          petal, time);
    const p1a = project3D(s*0.15*d[0], s*0.35*d[1],      petal, time);
    const p1b = project3D(s*0.45*d[2], s*0.15*d[3],      petal, time);
    const p1  = project3D(s*0.42*d[4], -s*0.05*d[5],     petal, time);
    const p2a = project3D(s*0.48*d[6], -s*0.25*d[7],     petal, time);
    const p2b = project3D(s*0.35*d[8], -s*0.42*d[9],     petal, time);
    const p2  = project3D(s*0.12,       -s*0.48,          petal, time);
    const nR  = project3D(s*0.03,       -s*0.38,          petal, time);
    const nC  = project3D(0,           -s*0.42,          petal, time);
    const nL  = project3D(-s*0.03,      -s*0.38,          petal, time);
    const p3  = project3D(-s*0.12,      -s*0.48,          petal, time);
    const p4a = project3D(-s*0.35*d[10], -s*0.42*d[11],  petal, time);
    const p4b = project3D(-s*0.48*d[12], -s*0.25*d[13],  petal, time);
    const p4  = project3D(-s*0.42*d[14], -s*0.05*d[15],  petal, time);
    const p5a = project3D(-s*0.45*d[16], s*0.15*d[17],   petal, time);
    const p5b = project3D(-s*0.15*d[18], s*0.35*d[19],   petal, time);

    // 深度 & 朝向计算
    const all = [p0,p1,p1a,p1b,p2,p2a,p2b,p3,p4,p4a,p4b,p5a,p5b,nR,nC,nL];
    const avgZ = all.reduce((s,p)=>s+p.z,0) / all.length;
    const depthFade = 1 - (avgZ / CONFIG.depthRange) * 0.5;
    const v1 = {x:p1.x-p0.x, y:p1.y-p0.y};
    const v2 = {x:p4.x-p0.x, y:p4.y-p0.y};
    const cross = v1.x*v2.y - v1.y*v2.x;
    const facing = Math.abs(cross) / (Math.hypot(v1.x,v1.y)*Math.hypot(v2.x,v2.y)+0.001);
    const alpha = petal.opacity * depthFade * (0.35 + 0.65 * facing);
    if (alpha < 0.02) return;

    ctx.save();
    ctx.translate(petal.x, petal.y);
    ctx.globalAlpha = alpha;

    // 渐变
    const mnX = Math.min(p0.x,p1.x,p2.x,p3.x,p4.x);
    const mxX = Math.max(p0.x,p1.x,p2.x,p3.x,p4.x);
    const mnY = Math.min(p0.y,p1.y,p2.y,p3.y,p4.y);
    const mxY = Math.max(p0.y,p1.y,p2.y,p3.y,p4.y);
    const grad = ctx.createLinearGradient(mnX, mnY, mxX, mxY);
    grad.addColorStop(0, colorLight(1));
    grad.addColorStop(0.5, colorAlpha(1));
    grad.addColorStop(1, colorDark(1));
    ctx.fillStyle = grad;

    ctx.beginPath();
    ctx.moveTo(p0.x, p0.y);
    ctx.bezierCurveTo(p1a.x,p1a.y, p1b.x,p1b.y, p1.x,p1.y);
    ctx.bezierCurveTo(p2a.x,p2a.y, p2b.x,p2b.y, p2.x,p2.y);
    ctx.lineTo(nR.x, nR.y);
    ctx.quadraticCurveTo(nC.x, nC.y, nL.x, nL.y);
    ctx.lineTo(p3.x, p3.y);
    ctx.bezierCurveTo(p4a.x,p4a.y, p4b.x,p4b.y, p4.x,p4.y);
    ctx.bezierCurveTo(p5a.x,p5a.y, p5b.x,p5b.y, p0.x,p0.y);
    ctx.closePath();
    ctx.fill();

    // 主脉
    const vTop = project3D(0, -s*0.38, petal, time);
    const vBot = project3D(0, s*0.42, petal, time);
    ctx.strokeStyle = colorVein(1);
    ctx.lineWidth = 0.5 * all.reduce((s,p)=>s+p.scale,0)/all.length;
    ctx.globalAlpha = alpha * 0.3;
    ctx.beginPath();
    ctx.moveTo(vBot.x, vBot.y);
    ctx.quadraticCurveTo((vBot.x+vTop.x)/2+1, (vBot.y+vTop.y)/2, vTop.x, vTop.y);
    ctx.stroke();

    // 侧脉
    for (let i = 1; i <= 3; i++) {
      const t = i / 4;
      const vy = s*0.42 - t*s*0.8;
      const spd = s*0.2 * (1 - t*0.5);
      const vb = project3D(0, vy, petal, time);
      const vr = project3D(spd, vy+s*0.02, petal, time);
      const vl = project3D(-spd, vy+s*0.02, petal, time);
      const vrc = project3D(spd*0.6, vy-s*0.04, petal, time);
      const vlc = project3D(-spd*0.6, vy-s*0.04, petal, time);
      ctx.beginPath(); ctx.moveTo(vb.x,vb.y); ctx.quadraticCurveTo(vrc.x,vrc.y,vr.x,vr.y); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(vb.x,vb.y); ctx.quadraticCurveTo(vlc.x,vlc.y,vl.x,vl.y); ctx.stroke();
    }

    // 高光
    const hl = project3D(s*0.05, -s*0.1, petal, time);
    ctx.globalAlpha = alpha * 0.12 * facing;
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.ellipse(hl.x, hl.y, s*0.18*hl.scale, s*0.12*hl.scale, 0, 0, Math.PI*2);
    ctx.fill();

    ctx.restore();
  }

  // ---------- 创建花瓣 ----------
  function createPetal(startFromTop) {
    const size = rand(CONFIG.petalSize.min, CONFIG.petalSize.max);
    const d = [];
    for (let i = 0; i < 20; i++) d.push(rand(0.75, 1.25));
    return {
      x: rand(-80, canvas.width + 80),
      y: startFromTop ? rand(-200, -20) : rand(-canvas.height, canvas.height),
      size, d,
      rotX: rand(0, Math.PI*2), rotY: rand(0, Math.PI*2), rotZ: rand(0, Math.PI*2),
      spinX: rand(-0.0015, 0.0015), spinY: rand(-0.002, 0.002), spinZ: rand(-0.001, 0.001),
      worldZ: rand(-CONFIG.depthRange*0.3, CONFIG.depthRange*0.7),
      fallSpeed: rand(CONFIG.fallSpeed.min, CONFIG.fallSpeed.max),
      swaySpeed: rand(CONFIG.swaySpeed.min, CONFIG.swaySpeed.max),
      swayOffset: rand(0, Math.PI*2),
      opacity: rand(CONFIG.opacity.min, CONFIG.opacity.max),
      attractFrames: 0,
    };
  }

  // ---------- 鼠标吸引（向鼠标方向拉） ----------
  function applyMouseAttraction(p) {
    const dx = mouseX - p.x, dy = mouseY - p.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < CONFIG.attractRadius && dist > 5) {
      p.attractFrames++;
      const strength = (1 - dist / CONFIG.attractRadius) * CONFIG.attractForce;
      // 向鼠标方向拉
      p.x += (dx / dist) * strength * 3;
      // y 方向也向鼠标靠近，但不直接用 attractForce 避免过于生硬
      p.y += (dy / dist) * strength * 2;
      // 接近鼠标时稍微减速下落，模拟被"托住"
      if (dist < 80) p.fallSpeed *= 0.98;
      // 被吸引太久弹走
      if (p.attractFrames > CONFIG.maxAttractFrames) {
        p.x += (Math.random() - 0.5) * CONFIG.repelForce * 5;
        p.y -= CONFIG.repelForce * 3;
        p.fallSpeed = rand(CONFIG.fallSpeed.min, CONFIG.fallSpeed.max);
        p.attractFrames = 0;
      }
    } else {
      p.attractFrames = Math.max(0, p.attractFrames - 2);
    }
  }

  // ---------- 更新花瓣 ----------
  function updatePetal(p, dt) {
    p.y += p.fallSpeed * dt * 0.06;
    p.x += Math.sin(performance.now() * p.swaySpeed + p.swayOffset) * 0.4 * dt * 0.06;
    p.fallSpeed += 0.00008 * dt;
    if (p.y > canvas.height + 80 || p.x < -150 || p.x > canvas.width + 150) {
      Object.assign(p, createPetal(true));
      p.x = rand(-80, canvas.width + 80);
      p.y = rand(-120, -20);
    }
  }

  // ---------- 初始化 ----------
  function init() {
    petals = [];
    for (let i = 0; i < CONFIG.petalCount; i++) petals.push(createPetal(false));
  }

  // ---------- 动画循环 ----------
  function animate() {
    if (!isPageVisible) { animationId = requestAnimationFrame(animate); return; }
    const now = performance.now();
    const dt = Math.min(now - lastTime, 50);
    lastTime = now;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 深度排序
    petals.sort((a, b) => b.worldZ - a.worldZ);

    for (let i = 0; i < petals.length; i++) {
      updatePetal(petals[i], dt);
      applyMouseAttraction(petals[i]);
      drawPetal(petals[i], now);
    }

    animationId = requestAnimationFrame(animate);
  }

  document.addEventListener('visibilitychange', () => { isPageVisible = !document.hidden; });

  function start() {
    init();
    animate();
    document.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });
    document.addEventListener('mouseleave', () => { mouseX = -9999; mouseY = -9999; });
  }

  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start);

  document.addEventListener('astro:before-swap', () => {
    if (animationId !== null) cancelAnimationFrame(animationId);
    window.__sakuraLoaded = false;
  });
})();
</script>

<style>
  .sakura-bg {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .sakura-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .sakura-bg { display: none; }
  }
</style>

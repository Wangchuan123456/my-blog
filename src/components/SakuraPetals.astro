---
// 全屏樱花花瓣飘落（性能优化版）
// Canvas 轻量花瓣粒子系统，覆盖全页
---

<div class="sakura-bg" id="sakura-bg">
  <canvas id="sakura-canvas"></canvas>
</div>

<script>
// @ts-nocheck
(function () {
  // 防 View Transitions 双实例：全局锁
  if (window.__sakuraLoaded) return;
  window.__sakuraLoaded = true;

  const canvas = document.getElementById('sakura-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let petals = [];
  let animationId = null;
  let wind = 0;
  let windTimer = 0;
  let isPageVisible = true;
  let resizeTimer = null;
  let mouseX = -9999;
  let mouseY = -9999;

  // ---------- 配置 ----------
  const CONFIG = {
    petalCount: 36,        // 28→36，平衡性能与密度
    minSize: 5,
    maxSize: 11,
    fallSpeed: 0.35,
    swayAmplitude: 1.0,
    swayFrequency: 0.012,
    windStrength: 0.25,
    windInterval: 4000,
    // 鼠标吸引
    attractRadius: 200,
    attractForce: 0.12,
    maxAttractSpeed: 3.0,
    maxAttractFrames: 100,  // 被吸引多久后弹走（≈1.6秒）
    repelForce: 1.5,        // 弹走力度
  };

  // ---------- 花瓣颜色（5 种粉色调） ----------
  const PETAL_COLORS = [
    'rgba(255, 182, 193, ALPHA)',
    'rgba(255, 155, 170, ALPHA)',
    'rgba(252, 182, 193, ALPHA)',
    'rgba(255, 200, 210, ALPHA)',
    'rgba(245, 175, 185, ALPHA)',
  ];

  // ---------- 尺寸适配（防抖） ----------
  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  function debouncedResize() {
    if (resizeTimer) cancelAnimationFrame(resizeTimer);
    resizeTimer = requestAnimationFrame(resize);
  }

  // ---------- 花瓣类 ----------
  class Petal {
    constructor() {
      this.attractFrames = 0;
      this.reset();
    }
    reset() {
      this.x = Math.random() * canvas.width;
      this.y = -Math.random() * canvas.height - 20;
      this.size = Math.random() * (CONFIG.maxSize - CONFIG.minSize) + CONFIG.minSize;
      this.speedY = Math.random() * 0.3 + CONFIG.fallSpeed;
      this.speedX = (Math.random() - 0.5) * 0.2;
      this.rotation = Math.random() * Math.PI * 2;
      this.rotationSpeed = (Math.random() - 0.5) * 0.015;
      this.opacity = Math.random() * 0.35 + 0.3;
      this.colorIndex = Math.floor(Math.random() * PETAL_COLORS.length);
      this.swayOffset = Math.random() * 1000;
      this.time = Math.random() * 1000;
      this.attractFrames = 0;
    }
    update() {
      this.time++;
      // 被吸引太久就弹走，保证花瓣循环
      if (this.attractFrames > CONFIG.maxAttractFrames) {
        const angle = Math.random() * Math.PI * 2;
        this.speedX += Math.cos(angle) * CONFIG.repelForce;
        this.speedY += Math.sin(angle) * CONFIG.repelForce - 0.5; // 额外向上飘
        this.attractFrames = 0;
      }
      const sway = Math.sin(this.time * CONFIG.swayFrequency + this.swayOffset) * CONFIG.swayAmplitude;
      this.speedX += wind * 0.04;
      this.speedX *= 0.98;
      this.x += this.speedX + sway;
      this.y += this.speedY;
      this.rotation += this.rotationSpeed;
      if (this.y > canvas.height + 20 || this.x < -40 || this.x > canvas.width + 40) {
        this.reset();
        this.x = Math.random() * canvas.width;
        this.y = -20;
      }
    }
    draw() {
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rotation);
      const w = this.size;
      const h = this.size * 0.55;
      ctx.beginPath();
      ctx.ellipse(0, 0, w, h, 0, 0, Math.PI * 2);
      ctx.fillStyle = PETAL_COLORS[this.colorIndex].replace('ALPHA', this.opacity);
      ctx.fill();
      ctx.restore();
    }
  }

  // ---------- 鼠标吸引 ----------
  function applyMouseAttraction(petal) {
    const dx = mouseX - petal.x;
    const dy = mouseY - petal.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < CONFIG.attractRadius && dist > 1) {
      petal.attractFrames++;
      const strength = (1 - dist / CONFIG.attractRadius) * CONFIG.attractForce;
      petal.speedX += (dx / dist) * strength;
      petal.speedY += (dy / dist) * strength;
      const spd = Math.sqrt(petal.speedX * petal.speedX + petal.speedY * petal.speedY);
      if (spd > CONFIG.maxAttractSpeed) {
        petal.speedX = (petal.speedX / spd) * CONFIG.maxAttractSpeed;
        petal.speedY = (petal.speedY / spd) * CONFIG.maxAttractSpeed;
      }
    } else {
      petal.attractFrames = Math.max(0, petal.attractFrames - 2);
    }
  }

  // ---------- 初始化 ----------
  function init() {
    resize();
    petals = [];
    for (let i = 0; i < CONFIG.petalCount; i++) {
      const p = new Petal();
      p.y = Math.random() * canvas.height;
      petals.push(p);
    }
  }

  // ---------- 动画循环 ----------
  function animate() {
    if (!isPageVisible) {
      // 页面不可见时仅空转 rAF 不绘制，节省 GPU
      animationId = requestAnimationFrame(animate);
      return;
    }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    windTimer++;
    if (windTimer > CONFIG.windInterval / 16) {
      wind = (Math.random() - 0.5) * CONFIG.windStrength * 2;
      windTimer = 0;
    }
    wind *= 0.995;
    // for 循环比 forEach 快 2-3 倍
    for (let i = 0; i < petals.length; i++) {
      petals[i].update();
      applyMouseAttraction(petals[i]);
      petals[i].draw();
    }
    animationId = requestAnimationFrame(animate);
  }

  // ---------- 页面可见性（切标签页时暂停） ----------
  document.addEventListener('visibilitychange', () => {
    isPageVisible = !document.hidden;
  });

  // ---------- 启动 ----------
  function start() {
    init();
    animate();
    window.addEventListener('resize', debouncedResize);
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });
    document.addEventListener('mouseleave', () => {
      mouseX = -9999;
      mouseY = -9999;
    });
  }

  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start);

  // View Transitions 清理
  document.addEventListener('astro:before-swap', () => {
    if (animationId !== null) cancelAnimationFrame(animationId);
    window.__sakuraLoaded = false;
  });
})();
</script>

<style>
  .sakura-bg {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .sakura-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .sakura-bg { display: none; }
  }
</style>

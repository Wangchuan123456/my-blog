---
// 3D 场景背景组件 — 布吉岛·樱落风格
// 使用 Three.js 渲染草地 + 樱花树 + 溪流
// Canvas 樱花花瓣覆盖其上（已有）
---

<div class="three-bg" id="three-bg">
  <div id="three-canvas-container"></div>
</div>

<script>
// @ts-nocheck
import * as THREE from 'three';

(function () {
  // 防双实例
  if (window.__threeSceneLoaded) return;
  window.__threeSceneLoaded = true;

  const container = document.getElementById('three-canvas-container');
  if (!container) return;

  // ========== 场景 ==========
  const scene = new THREE.Scene();
  scene.background = null; // 透明，让 body 的背景透出来
  scene.fog = new THREE.Fog(0x0f0b2e, 12, 20); // 远处淡出

  // ========== 相机 ==========
  const aspect = window.innerWidth / window.innerHeight;
  const camera = new THREE.PerspectiveCamera(40, aspect, 0.1, 30);
  camera.position.set(0, 6, 9);
  camera.lookAt(0, 0, 0);

  // ========== 渲染器 ==========
  const renderer = new THREE.WebGLRenderer({
    alpha: true,
    antialias: true,
    powerPreference: 'high-performance',
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;
  container.appendChild(renderer.domElement);

  // ========== 灯光 ==========
  const ambientLight = new THREE.AmbientLight(0xffeedd, 0.4);
  scene.add(ambientLight);

  const mainLight = new THREE.DirectionalLight(0xffd5b8, 1.8);
  mainLight.position.set(5, 10, 5);
  mainLight.castShadow = true;
  mainLight.shadow.mapSize.width = 1024;
  mainLight.shadow.mapSize.height = 1024;
  scene.add(mainLight);

  const fillLight = new THREE.DirectionalLight(0xaab8ff, 0.4);
  fillLight.position.set(-3, 2, -5);
  scene.add(fillLight);

  const rimLight = new THREE.DirectionalLight(0xffc8d0, 0.6);
  rimLight.position.set(-2, 1, 6);
  scene.add(rimLight);

  // ========== 地形 ==========
  function createTerrain() {
    const geo = new THREE.PlaneGeometry(16, 16, 50, 50);
    geo.rotateX(-Math.PI / 2);
    const pos = geo.attributes.position;

    // 用 simplex 风格的随机起伏
    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i);
      const z = pos.getZ(i);
      // 柔和山丘
      const h = Math.sin(x * 0.5) * Math.cos(z * 0.6) * 0.2
              + Math.sin(x * 1.2 + z * 0.8) * 0.1
              + Math.cos(x * 0.3 + z * 1.5) * 0.15;
      pos.setY(i, h);
    }
    pos.needsUpdate = true;
    geo.computeVertexNormals();

    // 草地颜色渐变（根据高度）
    const colors = new Float32Array(pos.count * 3);
    for (let i = 0; i < pos.count; i++) {
      const y = pos.getY(i);
      const hFactor = (y + 0.4) / 0.8; // 0~1
      // 低处深绿，高处浅绿带黄
      const r = 0.15 + hFactor * 0.2;
      const g = 0.4 + hFactor * 0.25;
      const b = 0.1 + hFactor * 0.1;
      colors[i * 3] = r;
      colors[i * 3 + 1] = g;
      colors[i * 3 + 2] = b;
    }
    geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const mat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: 0.8,
      metalness: 0.0,
      flatShading: false,
    });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.receiveShadow = true;
    scene.add(mesh);
    return mesh;
  }
  const terrain = createTerrain();

  // ========== 溪流 ==========
  function createRiver() {
    const points = [];
    // 蜿蜒路径
    const segments = 30;
    for (let i = 0; i <= segments; i++) {
      const t = i / segments;
      const x = (t - 0.5) * 14;
      const z = Math.sin(t * Math.PI * 2.5) * 1.0 + Math.sin(t * Math.PI * 5) * 0.3;
      // 获取地形高度
      const y = Math.sin(x * 0.5) * Math.cos(z * 0.6) * 0.2
              + Math.sin(x * 1.2 + z * 0.8) * 0.1
              + Math.cos(x * 0.3 + z * 1.5) * 0.15;
      points.push(new THREE.Vector3(x, y - 0.02, z));
    }

    // 河流宽度沿路径变化
    const riverGeo = new THREE.BufferGeometry();
    const vertices = [];
    const width = 0.5;
    for (let i = 0; i < points.length; i++) {
      const p = points[i];
      const next = points[Math.min(i + 1, points.length - 1)];
      const dir = new THREE.Vector3().subVectors(next, p).normalize();
      const perp = new THREE.Vector3(-dir.z, 0, dir.x).multiplyScalar(width * (0.6 + Math.sin(i * 0.8) * 0.3));
      vertices.push(
        p.x + perp.x, p.y + 0.01, p.z + perp.z,
        p.x - perp.x, p.y + 0.01, p.z - perp.z,
      );
    }
    const indices = [];
    for (let i = 0; i < points.length - 1; i++) {
      const a = i * 2, b = i * 2 + 1, c = (i + 1) * 2, d = (i + 1) * 2 + 1;
      indices.push(a, c, b, b, c, d);
    }
    riverGeo.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
    riverGeo.setIndex(indices);
    riverGeo.computeVertexNormals();

    const riverMat = new THREE.MeshStandardMaterial({
      color: 0x7ec8e3,
      transparent: true,
      opacity: 0.5,
      roughness: 0.1,
      metalness: 0.3,
      side: THREE.DoubleSide,
    });
    const river = new THREE.Mesh(riverGeo, riverMat);
    river.position.y = 0;
    scene.add(river);

    // 河流发光层
    const glowMat = new THREE.MeshStandardMaterial({
      color: 0xa8d8ea,
      transparent: true,
      opacity: 0.2,
      roughness: 0.0,
      metalness: 0.5,
      side: THREE.DoubleSide,
    });
    const glow = new THREE.Mesh(riverGeo.clone(), glowMat);
    glow.position.y = 0.01;
    scene.add(glow);

    return { river, glow };
  }
  const river = createRiver();

  // ========== 樱花树 ==========
  const trees = [];

  function createTree(posX, posZ, scale) {
    const group = new THREE.Group();

    // 获取地形高度
    const h = Math.sin(posX * 0.5) * Math.cos(posZ * 0.6) * 0.2
            + Math.sin(posX * 1.2 + posZ * 0.8) * 0.1
            + Math.cos(posX * 0.3 + posZ * 1.5) * 0.15;

    group.position.set(posX, h, posZ);

    const s = 0.6 + scale * 0.4;

    // 树干
    const trunkGeo = new THREE.CylinderGeometry(0.04 * s, 0.08 * s, 0.6 * s, 6);
    const trunkMat = new THREE.MeshStandardMaterial({
      color: 0x5c4033,
      roughness: 0.9,
    });
    const trunk = new THREE.Mesh(trunkGeo, trunkMat);
    trunk.position.y = 0.3 * s;
    trunk.castShadow = true;
    group.add(trunk);

    // 树冠 - 多个粉色球体堆叠
    const crownColors = [0xf5b0c0, 0xf09db0, 0xe8829a, 0xd84f5a];
    const crownMat = new THREE.MeshStandardMaterial({
      roughness: 0.6,
      metalness: 0.0,
    });

    const positions = [
      [0, 0.7 * s, 0, 0.35 * s],
      [0.2 * s, 0.85 * s, 0.15 * s, 0.28 * s],
      [-0.18 * s, 0.8 * s, -0.1 * s, 0.25 * s],
      [0.1 * s, 0.95 * s, -0.12 * s, 0.22 * s],
      [-0.08 * s, 0.65 * s, 0.2 * s, 0.2 * s],
    ];

    positions.forEach(([x, y, z, r], i) => {
      const geo = new THREE.SphereGeometry(r, 7, 7);
      crownMat.color.setHex(crownColors[i % crownColors.length]);
      const sphere = new THREE.Mesh(geo, crownMat.clone());
      sphere.position.set(x, y, z);
      sphere.castShadow = true;
      group.add(sphere);
    });

    // 树枝摇摆动画数据
    group.userData = {
      swayOffset: Math.random() * Math.PI * 2,
      swaySpeed: 0.3 + Math.random() * 0.2,
      swayAmount: 0.01 + Math.random() * 0.01,
    };

    scene.add(group);
    trees.push(group);
    return group;
  }

  // 随机分布树木（避开河流区域）
  const treePositions = [
    [-3.5, -2.5], [3.0, -3.0], [-2.0, 2.5], [4.5, 1.5],
    [-4.0, 0.5], [2.5, -1.0], [-1.5, -3.5], [5.0, -1.8],
    [0.5, 3.5], [-4.5, -1.0], [3.8, 3.0], [-3.0, 1.8],
  ];

  treePositions.forEach(([x, z], i) => {
    // 简单避开河流区域
    const riverZ = Math.sin((x / 14 + 0.5) * Math.PI * 2.5) * 1.0 + Math.sin((x / 14 + 0.5) * Math.PI * 5) * 0.3;
    if (Math.abs(z - riverZ) < 0.6) return; // 离河流太近就不种树
    createTree(x, z, 0.6 + Math.random() * 0.4);
  });

  // ========== 场景动画 ==========
  let time = 0;
  let cameraAngle = 0;
  let mouseX = 0;
  let targetCamX = 0;

  // 鼠标影响相机轻微跟随
  document.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
  });

  function animate() {
    time += 0.01;
    cameraAngle += 0.0008;

    // 相机缓慢摆动
    targetCamX += (Math.sin(cameraAngle) * 0.8 - targetCamX) * 0.01;
    const mouseInfluence = mouseX * 0.3;
    camera.position.x = targetCamX + mouseInfluence;
    camera.position.y = 6 + Math.sin(cameraAngle * 0.5) * 0.2;
    camera.lookAt(0, 0, 0);

    // 树木摇摆
    trees.forEach(tree => {
      const d = tree.userData;
      const sway = Math.sin(time * d.swaySpeed + d.swayOffset) * d.swayAmount;
      tree.rotation.z = sway;
      tree.rotation.x = Math.sin(time * d.swaySpeed * 0.7 + d.swayOffset + 1) * d.swayAmount * 0.7;
    });

    // 河流微动
    if (river.river.material) {
      river.river.material.opacity = 0.45 + Math.sin(time * 0.5) * 0.05;
      river.glow.material.opacity = 0.15 + Math.sin(time * 0.7 + 1) * 0.08;
    }

    renderer.render(scene, camera);
    requestAnimationFrame(animate);
  }

  animate();

  // ========== 窗口适配 ==========
  window.addEventListener('resize', () => {
    const w = window.innerWidth;
    const h = window.innerHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });

  // ========== 清理 ==========
  document.addEventListener('astro:before-swap', () => {
    window.__threeSceneLoaded = false;
    renderer.dispose();
  });
})();
</script>

<style>
  .three-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    isolation: isolate;
  }
  .three-bg canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .three-bg { display: none; }
  }
</style>
